# Replace only the placeholder domain on the Raspberry Pi.
# Do not commit the production environment file or future keys/secrets.
API_BASE_URL=https://example-attendance-domain
DEVICE_ID=attendance-pi-01
REQUEST_TIMEOUT_SECONDS=5
ENROLLMENT_POLL_SECONDS=3
# Base64-encoded 16-byte AES-128 key. Replace only in /etc/rfid-attendance.env.
DEVICE_AES_KEY_BASE64=<base64-encoded-16-byte-key>
