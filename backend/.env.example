APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/attendance
APP_TIMEZONE=Europe/Helsinki
# Comma-separated frontend origins; Vite variables are public but this is not.
CORS_ORIGINS=http://localhost:5173
RFID_ENROLLMENT_TIMEOUT_SECONDS=60
# JSON mapping; use a real base64-encoded 16-byte key only in Coolify.
DEVICE_AES_KEYS_JSON={"attendance-pi-01":"<base64-encoded-16-byte-key>"}
